---
const {links} = Astro.props;
const socialLinks = [
  ["github", links.github, "fab fa-github"],
  ["linkedin", links.linkedin, "fab fa-linkedin-in"],
  ["google", links.gmail && `mailto:${links.gmail}`, "fas fa-envelope"],
  ["gitlab", links.gitlab, "fab fa-gitlab"],
  ["facebook", links.facebook, "fab fa-facebook-f"],
  ["instagram", links.instagram, "fab fa-instagram"],
  ["twitter", links.twitter, "fab fa-twitter"],
  ["medium", links.medium, "fab fa-medium"],
  ["stack-overflow", links.stackoverflow, "fab fa-stack-overflow"]
].filter(([, href]) => href);
---

{
  links.display && (
    <div class="social-media-div">
      {socialLinks.map(([name, href, icon]) => (
        <a
          href={href}
          class={`icon-button ${name}`}
          target={href.startsWith("mailto:") ? undefined : "_blank"}
          rel="noopener noreferrer"
          aria-label={name}
        >
          <i class={icon} aria-hidden="true" />
          <span />
        </a>
      ))}
    </div>
  )
}
