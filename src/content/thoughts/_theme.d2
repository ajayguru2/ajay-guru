# Shared D2 theme for every diagram on the site. Start each fence with:
#   ...@_theme.d2
#   *.style: {bold: false; stroke-width: 1}
# Colors mirror src/styles/site.css tokens (light / dark).
vars: {
  d2-config: {
    theme-overrides: {
      N1: "#1a1613"
      N2: "#6b635a"
      N3: "#a39a8c"
      N4: "#d6cdbd"
      N5: "#ede6d8"
      N6: "#f6f1e7"
      N7: "#f6f1e7"
      B1: "#1a1613"
      B2: "#6b635a"
      B3: "#d6cdbd"
      B4: "#ede6d8"
      B5: "#f6f1e7"
      B6: "#ede6d8"
      AA2: "#7a2e2a"
      AA4: "#d6cdbd"
      AA5: "#ede6d8"
      AB4: "#d6cdbd"
      AB5: "#ede6d8"
    }
    dark-theme-overrides: {
      N1: "#e6e0d4"
      N2: "#a39a8c"
      N3: "#6b635a"
      N4: "#332d26"
      N5: "#1f1b17"
      N6: "#15130f"
      N7: "#15130f"
      B1: "#e6e0d4"
      B2: "#a39a8c"
      B3: "#332d26"
      B4: "#1f1b17"
      B5: "#15130f"
      B6: "#1f1b17"
      AA2: "#d9907f"
      AA4: "#332d26"
      AA5: "#1f1b17"
      AB4: "#332d26"
      AB5: "#1f1b17"
    }
  }
}
style.fill: transparent
