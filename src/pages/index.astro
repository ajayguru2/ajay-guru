---
import {readFile} from "node:fs/promises";
import SocialLinks from "../components/SocialLinks.astro";
import contactMail from "../assets/images/contactMailDark.svg";
import developerActivity from "../assets/images/developerActivity.svg";
import manOnTable from "../assets/images/manOnTable.svg";
import skillImage from "../assets/images/skill.svg";
import {
  blogSection,
  contactInfo,
  educationInfo,
  greeting,
  openSource,
  skillsSection,
  socialMediaLinks,
  talkSection,
  techStack,
  twitterDetails,
  workExperiences
} from "../portfolio";

import "../index.css";
import "../App.scss";
import "../containers/Main.scss";
import "../components/header/Header.scss";
import "../containers/greeting/Greeting.scss";
import "../components/button/Button.scss";
import "../components/socialMedia/SocialMedia.scss";
import "../containers/skills/Skills.scss";
import "../components/softwareSkills/SoftwareSkill.scss";
import "../containers/skillProgress/Progress.scss";
import "../containers/education/Education.scss";
import "../components/educationCard/EducationCard.scss";
import "../containers/workExperience/WorkExperience.scss";
import "../components/experienceCard/ExperienceCard.scss";
import "../containers/projects/Project.scss";
import "../components/githubRepoCard/GithubRepoCard.scss";
import "../containers/blogs/Blog.scss";
import "../components/blogCard/BlogCard.scss";
import "../containers/talks/Talks.scss";
import "../components/talkCard/TalkCard.scss";
import "../containers/twitter-embed/twitter.scss";
import "../containers/contact/Contact.scss";
import "../components/footer/Footer.scss";
import "../containers/topbutton/Top.scss";

const assetPath = asset => (typeof asset === "string" ? asset : asset.src);
let repositories = [];

try {
  const profile = JSON.parse(await readFile("public/profile.json", "utf8"));
  repositories = profile.data.user.pinnedItems.edges;
} catch {
  // Local development still works when GitHub data has not been fetched.
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajay Guru</title>
    <meta name="title" content="Ajay Guru" />
    <meta name="description" content="Portfolio" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ajay.guru" />
    <meta property="og:title" content="Ajay Guru Portfolio" />
    <meta property="og:description" content="Ajay Guru Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AjayGuru0" />
    <meta
      name="twitter:description"
      content="Hopelessly in love with technology"
    />
    <link rel="icon" href="/main.ico" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/FortAwesome/Font-Awesome@5.15.4/css/all.min.css"
    />
  </head>
  <body>
    <div class="App">
      <div class="headroom-wrapper">
        <header class="header">
          <a href="/" class="logo">
            <span class="grey-color">&lt;</span>
            <span class="logo-name">{greeting.username}</span>
            <span class="grey-color">/&gt;</span>
          </a>
          <input class="menu-btn" type="checkbox" id="menu-btn" />
          <label class="menu-icon" for="menu-btn" aria-label="Toggle navigation">
            <span class="navicon" />
          </label>
          <ul class="menu">
            {skillsSection.display && <li><a href="#skills">Skills</a></li>}
            {workExperiences.display && <li><a href="#experience">Work Experiences</a></li>}
            {openSource.display && <li><a href="#opensource">Open Source</a></li>}
            {blogSection.display && <li><a href="#blogs">Blogs</a></li>}
            {talkSection.display && <li><a href="#talks">Talks</a></li>}
            <li><a href="#contact">Contact Me</a></li>
          </ul>
        </header>
      </div>

      {
        greeting.displayGreeting && (
          <section class="greet-main" id="greeting">
            <div class="greeting-main">
              <div class="greeting-text-div">
                <div>
                  <h1 class="greeting-text">
                    {greeting.title} <span class="wave-emoji">👋</span>
                  </h1>
                  <p class="greeting-text-p subTitle">{greeting.subTitle}</p>
                  <SocialLinks links={socialMediaLinks} />
                  <div class="button-greeting-div">
                    <div><a class="main-button" href="#contact">Contact me</a></div>
                    {greeting.resumeLink && (
                      <div>
                        <a class="main-button" href={greeting.resumeLink} target="_blank" rel="noopener noreferrer">
                          See my resume
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              </div>
              <div class="greeting-image-div">
                <img src={assetPath(manOnTable)} alt="Developer sitting at a desk" />
              </div>
            </div>
          </section>
        )
      }

      {
        skillsSection.display && (
          <section class="main" id="skills">
            <div class="skills-main-div">
              <div class="skills-image-div">
                <img src={assetPath(developerActivity)} alt="Developer working" loading="lazy" />
              </div>
              <div class="skills-text-div">
                <h2 class="skills-heading">{skillsSection.title}</h2>
                <p class="subTitle skills-text-subtitle">{skillsSection.subTitle}</p>
                <div class="software-skills-main-div">
                  <ul class="dev-icons">
                    {skillsSection.softwareSkills.map(skill => (
                      <li class="software-skill-inline">
                        <i class={skill.fontAwesomeClassname} aria-hidden="true" />
                        <p>{skill.skillName}</p>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  {skillsSection.skills.map(skill => <p class="subTitle skills-text">{skill}</p>)}
                </div>
              </div>
            </div>
          </section>
        )
      }

      {
        techStack.viewSkillBars && (
          <section class="skills-container" aria-labelledby="proficiency-title">
            <div class="skills-bar">
              <h2 class="skills-heading" id="proficiency-title">Proficiency</h2>
              {techStack.experience.map(item => (
                <div class="skill">
                  <p>{item.Stack}</p>
                  <div class="meter"><span style={`width: ${item.progressPercentage}`} /></div>
                </div>
              ))}
            </div>
            <div class="skills-image">
              <img src={assetPath(skillImage)} alt="Skills chart" loading="lazy" />
            </div>
          </section>
        )
      }

      {
        educationInfo.display && (
          <section class="education-section" id="education">
            <h2 class="education-heading">Education</h2>
            <div class="education-card-container">
              {educationInfo.schools.map(school => (
                <div>
                  <article class="education-card">
                    <div class="education-card-left">
                      <img class="education-roundedimg" src={assetPath(school.logo)} alt={school.schoolName} loading="lazy" />
                    </div>
                    <div class="education-card-right">
                      <h3 class="education-text-school">{school.schoolName}</h3>
                      <div class="education-text-details">
                        <h4 class="education-text-subHeader">{school.subHeader}</h4>
                        <p class="education-text-duration">{school.duration}</p>
                        {school.desc && <p class="education-text-desc">{school.desc}</p>}
                        <ul>{school.descBullets.map(item => <li class="subTitle">{item}</li>)}</ul>
                      </div>
                    </div>
                  </article>
                  <div class="education-card-border" />
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        workExperiences.display && (
          <section class="experience-container" id="experience">
            <h2 class="experience-heading">Experiences</h2>
            <div class="experience-cards-div">
              {workExperiences.experience.map(job => (
                <article class="experience-card">
                  <div class="experience-banner">
                    <div class="experience-blurred_div" />
                    <div class="experience-div-company"><h3 class="experience-text-company">{job.company}</h3></div>
                    <img class="experience-roundedimg" src={assetPath(job.companylogo)} alt={job.company} loading="lazy" />
                  </div>
                  <div class="experience-text-details">
                    <h3 class="experience-text-role">{job.role}</h3>
                    <p class="experience-text-date">{job.date}</p>
                    {job.desc && <p class="subTitle experience-text-desc">{job.desc}</p>}
                    <ul>{job.descBullets.map(item => <li class="subTitle">{item}</li>)}</ul>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        openSource.display && repositories.length > 0 && (
          <section class="main" id="opensource">
            <h2 class="project-title">Open Source Projects</h2>
            <div class="repo-cards-div-main">
              {repositories.map(({node: repo}) => (
                <a class="repo-card-link" href={repo.url} target="_blank" rel="noopener noreferrer">
                  <article class="repo-card-div">
                    <div class="repo-name-div">
                      <svg aria-hidden="true" class="octicon repo-svg" height="20" viewBox="0 0 12 16" width="14">
                        <path fill-rule="evenodd" d="M4 9H3V8h1v1zm0-3H3v1h1V6zm0-2H3v1h1V4zm0-2H3v1h1V2zm8-1v12c0 .55-.45 1-1 1H6v2l-1.5-1.5L3 16v-2H1c-.55 0-1-.45-1-1V1c0-.55.45-1 1-1h10c.55 0 1 .45 1 1zm-1 10H1v2h2v-1h3v1h5v-2zm0-10H2v9h9V1z" />
                      </svg>
                      <h3 class="repo-name">{repo.name}</h3>
                    </div>
                    <p class="repo-description">{repo.description}</p>
                    <div class="repo-stats">
                      <div class="repo-left-stat">
                        {repo.primaryLanguage && (
                          <span><i class="language-color" style={`background-color: ${repo.primaryLanguage.color}`} /><p>{repo.primaryLanguage.name}</p></span>
                        )}
                        <span><i class="fas fa-code-branch" aria-hidden="true" /><p>{repo.forkCount}</p></span>
                        <span><i class="fas fa-star" aria-hidden="true" /><p>{repo.stargazers.totalCount}</p></span>
                      </div>
                      <div class="repo-right-stat"><p>{repo.diskUsage} KB</p></div>
                    </div>
                  </article>
                </a>
              ))}
            </div>
            <div class="project-button">
              <a class="main-button" href={socialMediaLinks.github} target="_blank" rel="noopener noreferrer">More Projects</a>
            </div>
          </section>
        )
      }

      {
        blogSection.display && (
          <section class="main" id="blogs">
            <div class="blog-header">
              <h2 class="blog-header-text">{blogSection.title}</h2>
              <p class="subTitle blog-subtitle">{blogSection.subtitle}</p>
            </div>
            <div class="blog-main-div">
              <div class="blog-text-div">
                {blogSection.blogs.map(blog => (
                  <div class="blog-container">
                    <a class="blog-card" href={blog.url} target="_blank" rel="noopener noreferrer">
                      <h3 class="blog-title">{blog.title}</h3>
                      <p class="small">{blog.description}</p>
                      <div class="go-corner"><div class="go-arrow">→</div></div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {
        talkSection.display && (
          <section class="main" id="talks">
            <div class="talk-header">
              <h2 class="talk-header-title">{talkSection.title}</h2>
              <p class="subTitle talk-header-subtitle">{talkSection.subtitle}</p>
              {talkSection.talks.map(talk => (
                <div class="container">
                  <article class="rectangle">
                    <div class="diagonal-fill" />
                    <h3 class="talk-card-title">{talk.title}</h3>
                    <p class="talk-card-subtitle">{talk.subtitle}</p>
                    <div class="card-footer-button-div">
                      <a href={talk.slides_url} target="_blank" rel="noopener noreferrer" class="talk-button">Slides</a>
                      <a href={talk.event_url} target="_blank" rel="noopener noreferrer" class="talk-button">Event</a>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        twitterDetails.display && twitterDetails.userName && (
          <section class="tw-main-div" id="twitter">
            <div class="centerContent">
              <a class="main-button" href={`https://twitter.com/${twitterDetails.userName}`} target="_blank" rel="noopener noreferrer">
                Follow @{twitterDetails.userName}
              </a>
            </div>
          </section>
        )
      }

      <section class="main contact-margin-top" id="contact">
        <div class="contact-div-main">
          <div class="contact-header">
            <h2 class="heading contact-title">{contactInfo.title}</h2>
            <p class="subTitle contact-subtitle">{contactInfo.subtitle}</p>
            <div class="contact-text-div">
              {contactInfo.number && <><a class="contact-detail" href={`tel:${contactInfo.number}`}>{contactInfo.number}</a><br /><br /></>}
              <a class="contact-detail-email" href={`mailto:${contactInfo.email_address}`}>{contactInfo.email_address}</a>
              <br /><br />
              <SocialLinks links={socialMediaLinks} />
            </div>
          </div>
          <div class="contact-image-div">
            <img src={assetPath(contactMail)} alt="Sending a message" loading="lazy" />
          </div>
        </div>
      </section>

      <footer class="footer-div">
        <p class="footer-text">Made with ❤️ and ☕️</p>
        <p class="footer-text">© 2022</p>
      </footer>
      <button id="topButton" title="Go to top" aria-label="Go to top">
        <i class="fas fa-hand-point-up" aria-hidden="true" />
      </button>
    </div>

    <script>
      const topButton = document.querySelector("#topButton");
      const updateTopButton = () => {
        if (topButton) topButton.style.visibility = scrollY > 20 ? "visible" : "hidden";
      };
      topButton?.addEventListener("click", () => scrollTo({top: 0, behavior: "smooth"}));
      addEventListener("scroll", updateTopButton, {passive: true});
      updateTopButton();
    </script>
  </body>
</html>

<style is:global>
  .repo-card-link {
    color: inherit;
    text-decoration: none;
  }

  .repo-left-stat i:not(.language-color) {
    margin-right: 0.3rem;
  }
</style>
