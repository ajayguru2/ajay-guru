---
import Base from "../components/Base.astro";
import ThoughtList from "../components/ThoughtList.astro";
import { thoughts, work, slug } from "../lib";

const latest = (await thoughts()).slice(0, 1);
const entries = (await work()).slice(0, 2);
---

<Base>
  <section class="lead">
    <p class="statement">I like figuring out how things work.</p>
    <p class="sub">I’m a software engineer in Bangalore. These days I lead the Integrations team at Regie.ai. Before that, I worked on a cooking robot at Nymble.</p>
  </section>

  <section class="section" aria-labelledby="work-label">
    <div class="section-head">
      <h2 class="label" id="work-label">Selected work</h2>
      <a href="/work/">All work →</a>
    </div>
    <div class="work-list">
      {entries.map(({ id, data }) => (
        <article>
          <h3><a href={`/work/#${slug(id)}`}>{data.title}</a></h3>
          <span class="mono" set:html={data.byline} />
          <p>{data.blurb}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="thoughts-label">
    <div class="section-head">
      <h2 class="label" id="thoughts-label">Latest thought</h2>
      <a href="/thoughts/">All thoughts →</a>
    </div>
    <ThoughtList items={latest} full />
  </section>

  <div class="section prose">
    <p>Let’s connect on <a href="https://x.com/AjayGuru0" rel="me">Twitter</a>.</p>
  </div>
</Base>
