---
import Base from "../components/Base.astro";
import ThoughtList from "../components/ThoughtList.astro";
import { thoughts, work, slug } from "../lib";

const latest = (await thoughts()).slice(0, 5);
const entries = await work();
---

<Base>
  <section class="lead">
    <p class="statement">I like figuring out how things really work. I follow messy problems across code, systems and people, then try to leave things clearer than I found them.</p>
    <p class="sub">Currently building at Regie.ai in Bangalore. Before that: Nymble, Incubyte and Siemens.</p>
  </section>

  <section class="section" aria-labelledby="work-label">
    <div class="section-head">
      <span class="label" id="work-label">Work</span>
      <a href="/work/">All work →</a>
    </div>
    <div class="work-list">
      {entries.map(({ id, data }) => (
        <article>
          <h2><a href={`/work/#${slug(id)}`}>{data.title}</a></h2>
          <span class="mono" set:html={data.byline} />
          <p>{data.blurb}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="thoughts-label">
    <div class="section-head">
      <span class="label" id="thoughts-label">Thoughts</span>
      <a href="/thoughts/">All thoughts →</a>
    </div>
    <ThoughtList items={latest} />
  </section>
</Base>
