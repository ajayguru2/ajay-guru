---
import { render } from "astro:content";
import Base from "../../components/Base.astro";
import { thoughts } from "../../lib";

export async function getStaticPaths() {
  return (await thoughts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const long = (d: Date) => d.toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
const { title, date, updated, summary } = entry.data;
---

<Base title={title} section="thoughts" description={summary}>
  <article>
    <header class="page-title article-head">
      <h1>{title}</h1>
      <p class="meta">
        {entry.id.startsWith("_") && <><span class="todo">draft</span>{" · "}</>}
        Written {long(date)}{updated && ` · updated ${long(updated)}`}
      </p>
    </header>
    <div class="prose article-body">
      <Content />
    </div>
    <footer class="reading-end prose">
      <p><a href="/thoughts/">← Back to Thoughts</a></p>
      <p>What do you think? <a href={`mailto:hi@ajay.guru?subject=${encodeURIComponent(title)}`}>Write to me</a>. I’d like to hear your take.</p>
    </footer>
  </article>
</Base>
