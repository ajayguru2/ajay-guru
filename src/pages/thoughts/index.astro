---
import Base from "../../components/Base.astro";
import ThoughtList from "../../components/ThoughtList.astro";
import { thoughts } from "../../lib";

const items = await thoughts();
---

<Base title="Thoughts" section="thoughts" description="Things I’m learning and want to write about. Starting with how I study.">
  <header class="page-title">
    <h1>Thoughts</h1>
    <p class="sub">Sometimes I learn something and want to write about it. There’s only one post here so far, but I’d like to keep doing this.</p>
  </header>
  <ThoughtList items={items} full />
</Base>
