---
import { render } from "astro:content";
import Base from "../components/Base.astro";
import { work, slug } from "../lib";

const entries = await Promise.all(
  (await work()).map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base title="Work" section="work" description="Some of the software I’ve worked on, from CRM integrations at Regie.ai to a cooking robot at Nymble.">
  <header class="page-title">
    <h1>Work</h1>
    <p class="sub">I’ve worked on a cooking robot, lending software and now CRM integrations. Here’s a bit about what went into each, starting with what I do now.</p>
  </header>

  <div class="work-entries">
    {entries.map(({ entry, Content }) => (
      <article class="work-entry" id={slug(entry.id)}>
        <h2>{entry.data.title}</h2>
        <p class="byline" set:html={entry.data.byline} />
        <div class="prose"><Content /></div>
      </article>
    ))}
  </div>

  <div class="section prose">
    <p>Working on something similar? <a href="mailto:hi@ajay.guru">Tell me about it</a>. I’d like to hear how you’re approaching it.</p>
  </div>
</Base>
