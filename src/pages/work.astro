---
import { render } from "astro:content";
import Base from "../components/Base.astro";
import { work, slug } from "../lib";

const entries = await Promise.all(
  (await work()).map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Base title="Work" section="work" description="The systems Ajay Guru would point to if you asked what he actually did — four things, and what was hard about each.">
  <header class="page-title">
    <h1>Work</h1>
    <p class="sub">The systems I would point to if you asked what I actually did. Not a résumé — four things, and what was hard about each.</p>
  </header>

  <div class="work-entries">
    {entries.map(({ entry, Content }) => (
      <article class="work-entry" id={slug(entry.id)}>
        <h2>{entry.data.title}</h2>
        <p class="byline" set:html={entry.data.byline} />
        <div class="prose"><Content /></div>
        <p class="stack">{entry.data.stack.join(" · ")}</p>
      </article>
    ))}
  </div>
</Base>
